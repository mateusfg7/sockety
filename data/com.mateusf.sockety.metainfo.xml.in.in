<?xml version="1.0" encoding="UTF-8"?>
<!-- Mateus Felipe Gonçalves 2026 <mateusfg7.kmclara@gmail.com> -->
<component type="desktop-application">
  <id>@app-id@</id>
  <metadata_license>CC0</metadata_license>
  <!-- FIXME Insert your license of choice here -->
  <!-- <project_license>MIT</project_license> -->
  <name>Sockety</name>
  <summary>Test and debug Socket.IO servers</summary>
  <description>
    <p>
      Sockety is a native GNOME client for connecting to Socket.IO servers,
      emitting events and inspecting what comes back, without leaving your
      desktop for a browser-based tool.
    </p>
  </description>
  <url type="homepage">https://github.com/mateusfg7/sockety</url>
  <url type="bugtracker">https://github.com/mateusfg7/sockety/issues</url>
  <url type="vcs-browser">https://github.com/mateusfg7/sockety</url>
  <!-- Translation repository -->
  <url type="translate">https://github.com/mateusfg7/sockety/tree/main/po</url>
  <!-- Open Age Ratings Service:
       https://hughsie.github.io/oars/generate.html
  -->
  <content_rating type="oars-1.1" />
  <releases>
    <release version="0.1.0" date="2026-09-18" />
  </releases>
  <!-- developer_name tag deprecated with Appstream 1.0 -->
  <developer_name translate="no">Mateus Felipe Gonçalves</developer_name>
  <!-- Introduced with Appstream 1.0, but not yet fully supported by corresponding projects -->
  <developer id="io.github.mateusfg7">
    <name translate="no">Mateus Felipe Gonçalves</name>
  </developer>
  <!-- FIXME Set brand colors once the app icon is designed:
       https://docs.flathub.org/docs/for-app-authors/metainfo-guidelines/#brand-color
  <branding>
    <color type="primary" scheme_preference="light">#rrggbb</color>
    <color type="primary" scheme_preference="dark">#rrggbb</color>
  </branding>
  -->
  <update_contact>mateusfg7.kmclara@gmail.com</update_contact>
  <translation type="gettext">@gettext-package@</translation>
  <launchable type="desktop-id">@app-id@.desktop</launchable>
</component>
